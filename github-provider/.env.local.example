# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will never be committed.
#
# Port-forward required before running locally:
#   kubectl port-forward -n kafka   svc/kafka   9092:9092
#   kubectl port-forward -n minio   svc/minio   9000:9000
#   kubectl port-forward -n mongodb svc/mongodb 27017:27017  # only needed for npm run dev

KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=architectai-builds
MONGODB_URI=mongodb://localhost:27017/architectai
GITHUB_POLL_INTERVAL_MS=10000
GITHUB_MAX_POLL_ATTEMPTS=30
PORT=3002

# smoke-test.js only — Auth0 sub of a user with githubToken in MongoDB
# Find it with: db.users.findOne({}, { userId: 1 })
TEST_USER_ID=auth0|xxxxxxxxxxxxxxxxxxxx
